// -----------------------------------------------------------------------------
// Black Tiger memory interface
//
// Normally generated by JTFRAME from mem.yaml.
// Local copy for the MEGA65 port.
// -----------------------------------------------------------------------------

// Main CPU ROM - 8 bit
output [18:0] main_addr,
output        main_cs,
input         main_ok,
input  [7:0]  main_data,

// Sound CPU ROM - 8 bit
output [14:0] snd_addr,
output        snd_cs,
input         snd_ok,
input  [7:0]  snd_data,

// Character ROM - 16 bit
output [14:1] char_addr,
input         char_ok,
input  [15:0] char_data,

// Scroll ROM - 16 bit
output [17:1] scr_addr,
input         scr_ok,
input  [15:0] scr_data,

// Object ROM - 16 bit
output [17:1] obj_addr,
input         obj_ok,
input  [15:0] obj_data,

// ROM/PROM programming interface
input  [25:0] ioctl_addr,
input  [24:0] prog_addr,
input  [15:0] prog_data,
input  [1:0]  prog_ba,
input         prom_we